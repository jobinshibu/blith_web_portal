<IfModule mod_rewrite.c>
  RewriteEngine On
  # Since your Vite app is hosted in the /events/ directory (based on vite.config.js),
  # the RewriteBase must reflect that subdirectory.
  RewriteBase /events/

  # 1. Intercept Social Bots/Crawlers (WhatsApp, Facebook, Twitter, Telegram, Discord, LinkedIn, Slack, etc.)
  # for individual event links (e.g. /events/BLEV-123) to generate dynamic Open Graph (OG) meta tags.
  # Real human users and ad clicks bypass event.php completely and load index.html directly with all parameters intact.
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|WhatsApp|TelegramBot|Discordbot|LinkedInBot|Slackbot|Pinterest|Googlebot|bingbot|Applebot) [NC]
  RewriteCond %{QUERY_STRING} !(^|&)ssr=false(&|$)
  RewriteRule ^([a-zA-Z0-9_-]+)/?$ event.php?id=$1 [L,QSA]

  # 2. Standard SPA fallback for React Router
  # If the file or directory doesn't physically exist, serve index.html
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /events/index.html [L]
</IfModule>
